---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("post");
	return posts
		.filter((p) => !p.data.draft)
		.map((p) => ({
			params: { slug: p.id }, // in newer Astro versions, id is often used, but slug works if configured. I'll use p.slug or p.id.
			props: { post: p },
		}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title}>
	<div class="mb-12 flex items-center justify-between">
		<a
			href="/"
			class="group flex items-center gap-2 font-mono text-sm text-zinc-500 transition-colors hover:text-zinc-300"
		>
			<span class="transition-transform duration-300 group-hover:-translate-x-1">←</span>
			Back to Home
		</a>
		<button
			id="theme-toggle"
			aria-label="Toggle theme"
			class="flex h-11 w-11 items-center justify-center rounded-full border border-zinc-800 bg-zinc-900/60 text-zinc-400 transition-all hover:border-cyan-500/50 hover:text-cyan-400 sm:h-8 sm:w-8"
		>
			<svg
				id="sun-icon"
				class="hidden h-5 w-5 sm:h-4 sm:w-4"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
				></path>
			</svg>
			<svg
				id="moon-icon"
				class="hidden h-5 w-5 sm:h-4 sm:w-4"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
				></path>
			</svg>
		</button>
	</div>

	<article>
		<header class="mb-12 flex flex-col items-start border-b border-zinc-800/60 pb-10">
			<div class="mb-6 flex items-center gap-3 font-mono text-xs text-zinc-500">
				<time>
					{
						post.data.publishDate.toLocaleDateString("zh-CN", {
							year: "numeric",
							month: "2-digit",
							day: "2-digit",
						})
					}
				</time>
				<span class="text-zinc-700">•</span>
				<span
					class={`inline-flex items-center rounded-md border px-2 py-0.5 font-medium tracking-wide uppercase
          ${
						post.data.tags?.[0] === "docker" ||
						post.data.tags?.[0] === "network" ||
						post.data.tags?.[0] === "infra"
							? "border-cyan-500/30 bg-cyan-950/40 text-cyan-400"
							: "border-indigo-500/30 bg-indigo-950/40 text-indigo-400"
					}`}
				>
					{post.data.tags?.[0] || "Uncategorized"}
				</span>
			</div>

			<h1
				class="bg-gradient-to-b from-white via-zinc-200 to-zinc-500 bg-clip-text text-4xl leading-tight font-black tracking-tighter text-transparent sm:text-5xl"
				style={`view-transition-name: title-${post.id}`}
			>
				{post.data.title}
			</h1>

			<p
				class="mt-6 border-l-2 border-zinc-800 pl-4 text-base leading-relaxed text-zinc-400 sm:text-lg"
			>
				{post.data.description}
			</p>
		</header>

		<div class="prose prose-custom mt-10 max-w-none">
			<Content />
		</div>
	</article>
</BlogLayout>
